+def _array_digest(values: Any) -> str:
+    """Hash array contents without copying dense expression matrices to bytes."""
+    digest = hashlib.sha256()
+    if issparse(values):
+        matrix = values.tocsr(copy=False)
+        digest.update(str(matrix.shape).encode())
+        arrays = (matrix.data, matrix.indices, matrix.indptr)
+    else:
+        arrays = (np.asarray(values),)
+    for array in arrays:
+        if array.dtype.kind == "O":
+            array = array.astype(str)
+        digest.update(str(array.shape).encode())
+        digest.update(str(array.dtype).encode())
+        if array.size:
+            digest.update(memoryview(np.ascontiguousarray(array)).cast("B"))
+    return digest.hexdigest()
+
+
+def _split_provenance(
+    adata: anndata.AnnData,
+    perturbation_column: str,
+    context_key: str | None,
+    basal_embedding_key: str | None,
+) -> dict[str, Any]:
+    """Identify the exact training, validation, or prediction data in a checkpoint."""
+    provenance = {
+        "shape": list(adata.shape),
+        "obs_names": _array_digest(adata.obs_names.to_numpy()),
+        "var_names": _array_digest(adata.var_names.to_numpy()),
+        "perturbations": _array_digest(adata.obs[perturbation_column].to_numpy()),
+        "expression": _array_digest(adata.X),
+    }
+    if context_key is not None:
+        provenance["contexts"] = _array_digest(adata.obs[context_key].to_numpy())
+    if basal_embedding_key is not None:
+        provenance["basal_embedding"] = _array_digest(adata.obsm[basal_embedding_key])
+    return provenance
+
