+class _StateRunCheckpointState(pl.Callback):
+    """Preserve run identity and sampling RNGs alongside Lightning's training state."""
+
+    def __init__(self, provenance: dict[str, Any]):
+        self.provenance = provenance
+        self.training_complete = False
+        self._resume_rng: dict[str, Any] | None = None
+        self._epoch_start = 0.0
+
+    def validate_checkpoint(self, checkpoint: dict[str, Any]) -> None:
+        if checkpoint.get("state_run_provenance") != self.provenance:
+            raise ValueError(
+                "STATE checkpoint provenance does not match this run's data, "
+                "embeddings, seed, or model settings. Use a separate checkpoint directory."
+            )
+
+    def on_save_checkpoint(
+        self, trainer: pl.Trainer, pl_module: pl.LightningModule, checkpoint: dict[str, Any]
+    ) -> None:
+        checkpoint["state_run_provenance"] = self.provenance
+        checkpoint["state_training_complete"] = self.training_complete
+        checkpoint["state_rng"] = {
+            "python": random.getstate(),
+            "numpy": np.random.get_state(),
+            "torch": torch.get_rng_state(),
+            "cuda": torch.cuda.get_rng_state_all() if torch.cuda.is_available() else None,
+        }
+
+    def on_load_checkpoint(
+        self, trainer: pl.Trainer, pl_module: pl.LightningModule, checkpoint: dict[str, Any]
+    ) -> None:
+        self.validate_checkpoint(checkpoint)
+        self._resume_rng = checkpoint.get("state_rng")
+
+    def on_fit_start(self, trainer: pl.Trainer, pl_module: pl.LightningModule) -> None:
+        if self._resume_rng is not None:
+            random.setstate(self._resume_rng["python"])
+            np.random.set_state(self._resume_rng["numpy"])
+            torch.set_rng_state(self._resume_rng["torch"].cpu())
+            if torch.cuda.is_available() and self._resume_rng["cuda"] is not None:
+                torch.cuda.set_rng_state_all([state.cpu() for state in self._resume_rng["cuda"]])
+            self._resume_rng = None
+
+    def on_train_epoch_start(self, trainer: pl.Trainer, pl_module: pl.LightningModule) -> None:
+        self._epoch_start = time.perf_counter()
+
+    def on_train_epoch_end(self, trainer: pl.Trainer, pl_module: pl.LightningModule) -> None:
+        if trainer.current_epoch < 3 or (trainer.current_epoch + 1) % 10 == 0:
+            print(
+                f"[STATE] epoch={trainer.current_epoch + 1} "
+                f"epoch_seconds={time.perf_counter() - self._epoch_start:.2f} "
+                f"global_step={trainer.global_step}",
+                flush=True,
+            )
